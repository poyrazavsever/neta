EXPO_PUBLIC_APP_ENV=production
# Opsiyonel: development/fork için ilk açılış varsayılanı.
# Universal store binary'si bu değer olmadan build edilir; kullanıcı domain/QR ile bağlanır.
EXPO_PUBLIC_NETA_ORIGIN=

# Her fork kendi uygulama kimliğini release build'den önce belirlemelidir.
NETA_APP_NAME=Neta
NETA_APP_SLUG=neta
NETA_APP_SCHEME=neta
NETA_IOS_BUNDLE_ID=com.neta.mobile
NETA_ANDROID_PACKAGE=com.neta.mobile

# Store sürüm kimlikleri. Her binary release'te build numaralarını artırın.
NETA_APP_VERSION=0.1.0
NETA_IOS_BUILD_NUMBER=1
NETA_ANDROID_VERSION_CODE=1
